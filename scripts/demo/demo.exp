#!/usr/bin/expect -f
# The demo's script, run by record.sh inside asciinema: types each command at a human pace into a
# bare bash, waits for it to finish, and clears the screen between scenes.
set timeout 60
set rcfile [lindex $argv 0]

# The rc file sets the prompt to a bare "$ ": no user, host or folder in any frame.
spawn -noecho /bin/bash --noprofile --rcfile $rcfile -i
stty rows 36 columns 100 < $spawn_out(slave,name)

proc prompt {} { expect -re {\$ $} }

# One key at a time, reading the echo after each, so every keystroke reaches the recording when it
# is typed (expect only passes output on while it reads).
proc run {command} {
  foreach key [split $command ""] {
    send -- $key
    expect -re .
    after [expr {50 + int(rand() * 90)}]
  }
  sleep 0.5
  send "\r"
}

# Ctrl-L: bash clears the screen and draws the prompt again.
proc next_scene {} {
  send "\014"
  prompt
  sleep 0.6
}

prompt
sleep 1

# 1. The opening and the menu, then Quit (the last item, one up from the first).
run "taste"
expect "What would you like to do?"
sleep 2.5
send "\033\[A"
sleep 0.8
send "\r"
prompt
sleep 1
next_scene

# 2. A brand from a website.
run "taste extract stripe.com"
prompt
sleep 4
next_scene

# 3. A brand check with a minimum score, as in CI.
run "taste check stripe.com --against tastelabs.com --min 0.8"
prompt
sleep 5
next_scene

# 4. The same brand as a DESIGN.md.
run "taste extract stripe.com --format design-md | head -30"
prompt
sleep 5

# Ending here closes bash without an "exit" on screen.
close
